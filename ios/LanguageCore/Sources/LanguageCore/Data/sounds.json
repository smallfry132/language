inal consonants (받침)","de":"Schlusskonsonanten (받침)"},"head":["","sounds like"],"rows":[{"base":"ㄱ","cells":[{"t":"각","sub":"k"},{"t":"약","sub":"yak"}],"match":{"final":"ㄱ"},"note":{"en":"ㄱ ㅋ ㄲ at the end all sound k, not released","de":"ㄱ ㅋ ㄲ klingen am Ende alle wie k, ohne Luft"}},{"base":"ㄴ","cells":[{"t":"간","sub":"n"},{"t":"산","sub":"san"}],"match":{"final":"ㄴ"}},{"base":"ㄷ","cells":[{"t":"갇","sub":"t"},{"t":"옷","sub":"ot"}],"match":{"final":"ㅅ"},"note":{"en":"ㄷ ㅅ ㅆ ㅈ ㅊ ㅌ ㅎ at the end all sound t","de":"ㄷ ㅅ ㅆ ㅈ ㅊ ㅌ ㅎ klingen am Ende alle wie t"}},{"base":"ㄹ","cells":[{"t":"갈","sub":"l"},{"t":"물","sub":"mul"}],"match":{"final":"ㄹ"}},{"base":"ㅁ","cells":[{"t":"감","sub":"m"},{"t":"봄","sub":"bom"}],"match":{"final":"ㅁ"}},{"base":"ㅂ","cells":[{"t":"갑","sub":"p"},{"t":"집","sub":"jip"}],"match":{"final":"ㅂ"}},{"base":"ㅇ","cells":[{"t":"강","sub":"ng"},{"t":"방","sub":"bang"}],"match":{"final":"ㅇ"}}]}],"drills":[{"id":"plain","name":{"en":"Plain, aspirated, tense","de":"Einfach, behaucht, gespannt"},"sets":[[{"t":"가"},{"t":"카"},{"t":"까"}],[{"t":"다"},{"t":"타"},{"t":"따"}],[{"t":"바"},{"t":"파"},{"t":"빠"}],[{"t":"자"},{"t":"차"},{"t":"짜"}],[{"t":"사"},{"t":"싸"}],[{"t":"불"},{"t":"풀"},{"t":"뿔"}],[{"t":"달"},{"t":"탈"},{"t":"딸"}]]},{"id":"vowels","name":{"en":"Similar vowels","de":"Ähnliche Vokale"},"sets":[[{"t":"어"},{"t":"오"}],[{"t":"으"},{"t":"우"}],[{"t":"여"},{"t":"요"}],[{"t":"워"},{"t":"와"}],[{"t":"서"},{"t":"소"}],[{"t":"그"},{"t":"구"}]]},{"id":"finals","name":{"en":"Final consonants","de":"Schlusskonsonanten"},"sets":[[{"t":"안"},{"t":"앙"}],[{"t":"암"},{"t":"압"}],[{"t":"간"},{"t":"갈"}],[{"t":"박"},{"t":"밥"}],[{"t":"산"},{"t":"상"}],[{"t":"곰"},{"t":"공"}]]}]},"zh":{"intro":{"en":"Mandarin syllables are an initial consonant plus a final, spoken in one of four tones (or the light neutral tone). Tap a cell to hear it; example words come from the HSK lists.","de":"Mandarin-Silben bestehen aus Anlaut und Auslaut und werden in einem von vier Tönen (oder dem leichten neutralen Ton) gesprochen. Ti